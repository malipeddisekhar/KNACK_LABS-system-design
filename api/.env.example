# ==============================================================================
# Production & Local Environment Configuration Template
# Project: URL Shortener (API, Background Worker, and One-Off Migrations)
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. API Service Configuration
# ------------------------------------------------------------------------------
# Port for the NestJS HTTP server (binds to 0.0.0.0). Defaults to 3000 if unset.
PORT=3000

# Canonical public base URL used to format the `short_url` field in responses.
# In production, set to your custom domain or deployment URL (e.g. https://short.example.com).
PUBLIC_BASE_URL=http://localhost:3000

# Symmetric secret for signing and validating authentication JWTs.
# PRODUCTION REQUIREMENT: Must be at least 32 characters with diverse character set.
# Generate with: openssl rand -base64 32
JWT_SECRET=replace-with-minimum-32-char-random-production-secret-value

# ------------------------------------------------------------------------------
# 2. Database Configuration (API, Worker, and Migration Job)
# ------------------------------------------------------------------------------
# PostgreSQL connection string for Prisma ORM and prisma migrate deploy.
# Required by: API service, Worker service, and One-Off Migration Job.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/url_shortener?schema=public

# ------------------------------------------------------------------------------
# 3. Redis / Queue Configuration (API and Worker)
# ------------------------------------------------------------------------------
# Redis connection string for redirect cache-aside and BullMQ background queue.
# Format: redis://[:password@]host[:port] or rediss:// for TLS-encrypted connections.
# Required by: API service (cache & queue producer) and Worker service (queue consumer).
REDIS_URL=redis://localhost:6379

# ------------------------------------------------------------------------------
# 4. Analytics Configuration (Optional / Shared)
# ------------------------------------------------------------------------------
# Number of days to retain click event analytics before purging. Defaults to 90.
RETENTION_DAYS=90

# ------------------------------------------------------------------------------
# 5. CI / Automated Testing ONLY (NEVER USE IN PRODUCTION)
# ------------------------------------------------------------------------------
# Dedicated test database connection string.
# SAFETY GUARD: Test harness strictly rejects any database name other than 'url_shortener_test'.
# Tests will halt immediately if this targets a development or production database.
TEST_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/url_shortener_test?schema=public

# ------------------------------------------------------------------------------
# 6. Deprecated / Removed Variables (Do NOT use)
# ------------------------------------------------------------------------------
# MONGODB_URI: Removed. The platform uses PostgreSQL via Prisma as its source of truth.
# API_KEY_A / API_KEY_B: Removed. Authentication is implemented using JWT tokens.
