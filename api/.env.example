# Copy to .env for local development. Empty secret/connection fields are
# intentional: provide real values through a local secret manager or deployment.

# REQUIRED: explicit active mode; accepted: development, staging, production.
NODE_ENV=development

# REQUIRED at runtime outside test mode; TCP port for the HTTP API.
PORT=3000

# REQUIRED in every mode. Generate a unique value (at least 32 diverse chars).
# Never commit or paste the generated value into source, logs, or this template.
JWT_SECRET=

# REQUIRED in every mode. Supply the environment-specific PostgreSQL URL.
# For tests, use a dedicated database named exactly url_shortener_test.
DATABASE_URL=

# REQUIRED in staging/production; OPTIONAL in development/test (localhost is used).
# Must be an origin only. Production requires HTTPS.
PUBLIC_BASE_URL=http://localhost:3000

# REQUIRED outside test mode. Comma-separated explicit browser origins; no wildcard.
# Production origins must use HTTPS. Bearer-token API does not enable credential cookies.
CORS_ORIGINS=http://localhost:3000

# REQUIRED outside test mode: error | warn | log | debug | verbose.
# Staging/production permit error, warn, or log only; prefer warn for production.
LOG_LEVEL=debug

# OPTIONAL in development/test; REQUIRED in staging/production for cache and queue.
# Use rediss:// when TLS is required. Never commit credentials embedded in the URL.
REDIS_URL=redis://localhost:6379

# OPTIONAL; defaults to 30 days and must be an integer from 1 through 3650.
RETENTION_DAYS=30

# REQUIRED for DB-backed test runs; OPTIONAL otherwise and test-only. Must target
# url_shortener_test; never copy DATABASE_URL into this variable. Leave blank
# unless running the guarded integration tests.
TEST_DATABASE_URL=
