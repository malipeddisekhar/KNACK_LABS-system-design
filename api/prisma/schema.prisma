generator client {
  provider        = "prisma-client"
  output          = "../src/generated/prisma"
  previewFeatures = ["partialIndexes"]
}

datasource db {
  provider = "postgresql"
}

enum TeamRole {
  OWNER
  ADMIN
  MEMBER
}

enum TeamInvitationStatus {
  PENDING
  ACCEPTED
  REVOKED
  EXPIRED
}

model Team {
  id         String      @id @default(uuid()) @db.Uuid
  name       String      @db.Text
  activitySequence BigInt @default(0) @map("activity_sequence")
  createdAt  DateTime    @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt  DateTime    @updatedAt @map("updated_at") @db.Timestamptz(6)
  members    TeamMember[]
  auditLogs  AuditLog[]
  invitations TeamInvitation[]
  activityEvents ActivityEvent[]
  comments   TeamComment[]

  @@map("teams")
}

model TeamMember {
  id        String   @id @default(uuid()) @db.Uuid
  teamId    String   @map("team_id") @db.Uuid
  userId    String   @map("user_id")
  role      TeamRole
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)
  team      Team     @relation(fields: [teamId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@unique([teamId, userId])
  @@index([userId])
  @@map("team_members")
}

model AuditLog {
  id         String   @id @default(uuid()) @db.Uuid
  teamId     String   @map("team_id") @db.Uuid
  actorId    String   @map("actor_id")
  action     String   @db.Text
  targetType String   @map("target_type") @db.Text
  targetId   String   @map("target_id") @db.Text
  outcome    String   @db.Text
  metadata   Json?    @db.JsonB
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  team       Team     @relation(fields: [teamId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@index([teamId, createdAt])
  @@index([actorId])
  @@map("audit_logs")
}

model TeamInvitation {
  id              String               @id @default(uuid()) @db.Uuid
  teamId          String               @map("team_id") @db.Uuid
  invitedByUserId String               @map("invited_by_user_id")
  invitedEmail    String               @map("invited_email") @db.Text
  /// Binds acceptance to Principal.principalId; null invitations fail closed at acceptance.
  recipientUserId String?              @map("recipient_user_id")
  role            TeamRole
  tokenHash       String               @unique @map("token_hash") @db.Text
  status          TeamInvitationStatus @default(PENDING)
  expiresAt       DateTime             @default(dbgenerated("(CURRENT_TIMESTAMP + INTERVAL '7 days')")) @map("expires_at") @db.Timestamptz(6)
  acceptedAt      DateTime?            @map("accepted_at") @db.Timestamptz(6)
  acceptedByUserId String?             @map("accepted_by_user_id")
  createdAt       DateTime             @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime             @updatedAt @map("updated_at") @db.Timestamptz(6)
  team            Team                 @relation(fields: [teamId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@unique([teamId, invitedEmail], where: raw("status = 'PENDING'"), map: "team_invitations_one_pending_per_team_email_key")
  @@index([teamId, invitedEmail, status])
  @@index([expiresAt])
  @@map("team_invitations")
}

model ActivityEvent {
  id         String   @id @default(uuid()) @db.Uuid
  teamId     String   @map("team_id") @db.Uuid
  sequence   BigInt
  actorId    String   @map("actor_id")
  type       String   @db.Text
  targetType String   @map("target_type") @db.Text
  targetId   String   @map("target_id") @db.Text
  metadata   Json?    @db.JsonB
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  team       Team     @relation(fields: [teamId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@unique([teamId, sequence])
  @@map("activity_events")
}

model TeamComment {
  id        String   @id @default(uuid()) @db.Uuid
  teamId    String   @map("team_id") @db.Uuid
  authorId  String   @map("author_id")
  body      String   @db.Text
  mentions  Json     @default("[]") @db.JsonB
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  team      Team     @relation(fields: [teamId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@index([teamId, createdAt])
  @@map("team_comments")
}

model Link {
  id          String       @id @default(uuid()) @db.Uuid
  code        String       @unique
  longUrl     String       @map("long_url") @db.Text
  createdAt   DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  principalId String       @map("principal_id")
  expiresAt   DateTime?    @map("expires_at") @db.Timestamptz(6)
  tags        String[]     @default([])
  clickEvents ClickEvent[]

  @@index([principalId])
  @@map("links")
}

model ClickEvent {
  id        String   @id @default(uuid()) @db.Uuid
  eventId   String   @unique @default(uuid()) @map("event_id")
  linkId    String   @map("link_id") @db.Uuid
  clickedAt DateTime @default(now()) @map("clicked_at") @db.Timestamptz(6)
  userAgent String   @map("user_agent") @db.Text
  referrer  String   @db.Text
  ipHash    String   @map("ip_hash") @db.Text
  link      Link     @relation(fields: [linkId], references: [id])

  @@index([linkId, clickedAt])
  @@map("click_events")
}
